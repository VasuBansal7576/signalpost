# api uses your key; mcp uses Exa's documented free, rate-limited keyless service.
SIGNALPOST_EXA_TRANSPORT=api
EXA_API_KEY=
# Uses the local Codex ChatGPT login; no model API key required.
SIGNALPOST_MODEL=gpt-6-luna
# Evaluator: set SIGNALPOST_MODEL_PROVIDER=openai, supply OPENAI_API_KEY,
# and replace SIGNALPOST_MODEL with an API model available to that key.
SIGNALPOST_MODEL_PROVIDER=chatgpt
OPENAI_API_KEY=
# Optional cost rates for API models that do not report a USD cost.
SIGNALPOST_MODEL_INPUT_USD_PER_MILLION=
SIGNALPOST_MODEL_OUTPUT_USD_PER_MILLION=
SIGNALPOST_DB=./data/signalpost.sqlite
SIGNALPOST_MAX_EXA_USD=10
SIGNALPOST_MAX_SEARCHES_PER_COMPANY=6
SIGNALPOST_MAX_PAGES_PER_COMPANY=12
EVE_TELEMETRY_DISABLED=1

# Optional source-cache override. NAV is built/refreshed automatically by the live runner.
SIGNALPOST_SOURCE_CACHE=./data/sources
# Optional NAV catalogue path override:
SIGNALPOST_NAV_CATALOGUE=
